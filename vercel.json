{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "^/$", "dest": "/site/home.html" },
    { "src": "^/home/?$", "dest": "/site/home.html" },
    { "src": "^/blog/?$", "dest": "/site/blog.html" },
    { "src": "^/docs/?$", "dest": "/site/docs.html" },
    { "src": "/site/(.*)", "dest": "/site/$1" },
    { "src": "/(.*)", "dest": "/site/$1" }
  ]
}
